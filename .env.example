# ─── Runtime ───
NODE_ENV=development
PORT=3000
HOST=localhost

# ─── Database ───
# Prod (Neon): set DATABASE_URL to single connection string. SSL auto-on.
# Local: leave DATABASE_URL blank, use split vars below.
DATABASE_URL=

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=appuser
DATABASE_PASSWORD=
DATABASE_NAME=appdb
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# ─── Auth ───
JWT_SECRET=change-me-in-prod

# ─── CORS ───
# Comma-separated origin list. Local dev defaults to http://localhost:4200.
# Prod: set to Vercel web URL, e.g. https://your-app.vercel.app
CORS_ORIGIN=http://localhost:4200

# ─── External APIs ───
# CoinGecko API key (optional). If not set, will use public API with rate limits.
COINGECKO_API_KEY=

# ─── Email ───
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
WEB_URL=http://localhost:4200